generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(cuid())
  clerkUserId          String        @unique
  plan                 String        @default("free")
  monthKey             String        @default("")
  minutesUsedMonth     Int           @default(0)
  extraMinutesMonth    Int           @default(0)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  billingMode          String?
  commitmentEndAt      DateTime?
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  subscriptionStatus   String?
  quotaExtraSeconds    Int           @default(0)
  quotaResetAt         DateTime?
  quotaSecondsTotal    Int           @default(600)
  quotaSecondsUsed     Int           @default(0)
  bonusSeconds         Int           @default(0)
  ecos                 Eco[]
  folders              Folder[]
  recordings           Recording[]
  transactions         Transaction[]
  usageEvents          UsageEvent[]

  @@index([clerkUserId])
  @@index([monthKey])
}

model Transaction {
  id                   String   @id @default(cuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String
  stripeSessionId      String?  @unique
  type                 String
  minutesDelta         Int      @default(0)
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
}

model Recording {
  id                String      @id @default(cuid())
  userId            String
  status            String      @default("PROCESSING")
  audioUrl          String?
  audioBlobSize     Int?
  durationSeconds   Float?
  mimeType          String?
  transcriptionText String?
  summaryJson       String?
  errorMessage      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  aiError           String?
  aiFinishedAt      DateTime?
  aiStartedAt       DateTime?
  aiStatus          String      @default("IDLE")
  durationMs        Int?
  usageRecorded     Boolean     @default(false)
  fileId            String?
  r2Key             String?
  pdfContext        String?     @db.Text
  sourceType        String?     @default("mic")
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageEvents       UsageEvent?

  @@index([userId])
  @@index([status])
  @@index([aiStatus])
  @@index([createdAt])
  @@index([usageRecorded])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDefault Boolean  @default(false)
  ecos      Eco[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Eco {
  id                String   @id @default(cuid())
  userId            String
  title             String
  content           String?
  audioUrl          String?
  transcriptionText String?
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  folderId          String?
  quiz              Json?
  folder            Folder?  @relation(fields: [folderId], references: [id])
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([archived])
  @@index([folderId])
}

model UsageEvent {
  id          String    @id @default(cuid())
  userId      String
  recordingId String    @unique
  secondsUsed Int
  createdAt   DateTime  @default(now())
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recordingId])
  @@index([createdAt])
}

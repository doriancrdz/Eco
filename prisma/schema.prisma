// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  clerkUserId         String    @unique
  plan                String    @default("free") // "free" | "student" | "pro" | "business"
  monthKey            String    @default("") // Format: "YYYY-MM" (ex: "2026-02")
  minutesUsedMonth    Int       @default(0) // Minutes consommées ce mois (legacy, deprecated)
  extraMinutesMonth   Int       @default(0) // Minutes de packs achetés ce mois (legacy, deprecated)
  quotaSecondsTotal   Int       @default(600) // Quota total en secondes (10 min par défaut pour free)
  quotaSecondsUsed    Int       @default(0) // Secondes consommées ce mois
  quotaExtraSeconds   Int       @default(0) // Secondes supplémentaires de packs achetés ce mois (legacy, deprecated)
  bonusSeconds        Int       @default(0) // Secondes bonus permanentes de packs achetés (jamais reset)
  quotaResetAt        DateTime? // Date de reset du quota (basé sur currentPeriodEnd ou monthKey)
  stripeCustomerId    String?   @unique // ID Stripe Customer
  stripeSubscriptionId String?  @unique // ID Stripe Subscription (si abonné)
  stripePriceId       String?   // Price ID Stripe actif (pour détecter annual_commit_monthly)
  billingMode         String?   // "monthly" | "yearly_upfront" | "annual_commit_monthly"
  commitmentEndAt     DateTime? // Fin d'engagement 12 mois (si annual_commit_monthly)
  subscriptionStatus  String?   // "active" | "past_due" | "unpaid" | "canceled" (Stripe subscription status)
  currentPeriodEnd    DateTime? // Fin de la période de facturation en cours
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  transactions Transaction[]
  ecos         Eco[]
  recordings   Recording[]
  folders      Folder[]
  usageEvents  UsageEvent[]

  @@index([clerkUserId])
  @@index([monthKey])
}

model Transaction {
  id                  String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String   // ID du prix Stripe (plan ou pack)
  type                 String   // "subscription" | "pack"
  minutesDelta         Int      @default(0) // Minutes ajoutées (pour packs) ou 0 (pour abonnements)
  createdAt            DateTime @default(now())

  @@index([userId])
  @@index([stripeCustomerId])
}

model Recording {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            String    @default("PROCESSING") // "PROCESSING" | "TRANSCRIBED" | "DONE" | "ERROR"
  audioUrl          String?   // URL de l'audio (local ou cloud)
  audioBlobSize     Int?      // Taille du blob audio en bytes
  durationSeconds   Float?    // Durée de l'enregistrement (legacy)
  durationMs        Int?      // Durée précise en millisecondes
  usageRecorded     Boolean   @default(false) // Flag pour éviter double débit
  mimeType          String?   // Format audio (audio/webm, audio/mp4, etc.)
  transcriptionText String?   // Texte de transcription (disponible après TRANSCRIBED)
  summaryJson       String?   // JSON du résumé (disponible après DONE)
  errorMessage      String?   // Message d'erreur si status = ERROR
  aiStatus          String    @default("IDLE") // "IDLE" | "GENERATING" | "DONE" | "FAILED"
  aiStartedAt       DateTime? // Début génération résumé
  aiFinishedAt      DateTime? // Fin génération résumé
  aiError           String?   // Erreur si aiStatus = FAILED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  usageEvents       UsageEvent[]

  @@index([userId])
  @@index([status])
  @@index([aiStatus])
  @@index([createdAt])
  @@index([usageRecorded])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ecos Eco[]

  @@index([userId])
}

model Eco {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  content           String?  // Contenu optionnel (transcription, résumé, etc.)
  audioUrl          String?  // URL de l'audio
  transcriptionText String?  // Texte de transcription
  folderId          String?  // ID du dossier (relation vers Folder)
  folder            Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([archived])
  @@index([folderId])
}

model UsageEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordingId String    @unique // Un seul événement par recording (idempotence)
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  secondsUsed Int       // Secondes consommées pour cet enregistrement
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([recordingId])
  @@index([createdAt])
}
